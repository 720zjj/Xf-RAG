PORT=3000
# 开发：http://localhost:3000；生产必须填写 HTTPS 域名
PUBLIC_APP_URL=http://localhost:3000
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_db_password
DB_NAME=iflytek_translator
JWT_SECRET=your_jwt_secret
# 管理员拥有的已就绪文档会作为公共知识库供所有登录用户检索
ADMIN_USERNAMES=admin
ADMIN_REGISTRATION_KEY=
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000
UPLOAD_DIR=./uploads
MAX_DOCUMENT_UPLOAD_MB=20
MAX_VIDEO_UPLOAD_MB=100
MINERU_API_KEY=your_mineru_api_key
MINERU_API_URL=https://mineru.net
MAX_MINERU_ZIP_MB=200
MAX_MINERU_EXTRACTED_MB=300

# ===== 文档后台任务（BullMQ + 本机 Docker Redis） =====
REDIS_URL=redis://127.0.0.1:6379
DOCUMENT_WORKER_CONCURRENCY=2
DOCUMENT_JOB_MAX_ATTEMPTS=3
DOCUMENT_QUEUE_TIMEOUT_MS=5000

# ===== RAG 回答生成用 LLM（OpenAI 兼容接口）=====
# 不配置则自动使用本地 Xenova/Qwen1.5-0.5B-Chat 模型
# 示例（任选其一）：
#   本地Ollama:      LLM_BASE_URL=http://localhost:11434/v1   LLM_MODEL=qwen2.5:7b
#   DeepSeek:        LLM_BASE_URL=https://api.deepseek.com/v1   LLM_MODEL=deepseek-chat
#   通义千问:         LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1   LLM_MODEL=qwen-plus
#   讯飞星火:         LLM_BASE_URL=https://spark-api-open.xf-yun.com/v1   LLM_MODEL=4.0Ultra
#   智谱 GLM:         LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4   LLM_MODEL=glm-4-flash
LLM_BASE_URL=
LLM_API_KEY=your_llm_api_key
LLM_MODEL=glm-4-flash

# ===== 本地 Embedding 向量化 =====
EMBED_MODEL=Xenova/bge-small-zh-v1.5
HF_MIRROR=https://hf-mirror.com
# 手工本机开发可删除此项或改为本地目录
# Docker Compose 部署时使用容器内持久化模型缓存目录
MODEL_CACHE_DIR=/data/models

# MCP stdio 服务必须显式指定读取哪个用户的知识库
MCP_USER_ID=1
