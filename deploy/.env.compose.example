# 仅用于本机开发与 Docker 配置校验，复制到仓库根目录的 .env.compose 后再自行修改。
# 生产环境：NODE_ENV=production、PUBLIC_APP_URL 使用真实 HTTPS 地址；CORS_ORIGINS 必须替换为与 PUBLIC_APP_URL 相同的真实 HTTPS 公开来源，且所有密码都必须替换。
# 生产 JWT_SECRET 必须使用新的 32 字符以上随机值；下方内容只是明确的占位符。
NODE_ENV=development
APP_BIND_ADDRESS=127.0.0.1
APP_PORT=3000
PUBLIC_APP_URL=http://localhost:3000

DB_NAME=iflytek_translator
MYSQL_ROOT_PASSWORD=replace-with-local-root-password
MYSQL_APP_USER=iflytek_app
MYSQL_APP_PASSWORD=replace-with-local-app-password
JWT_SECRET=replace-with-a-new-32-plus-character-production-jwt-secret

ADMIN_USERNAMES=admin
ADMIN_REGISTRATION_KEY=
CORS_ORIGINS=http://localhost:3000
# 同机 Nginx/Caddy 反向代理到 Docker 端口时，生产环境可设置：
# TRUST_PROXY=loopback,linklocal,uniquelocal
# 局域网直接暴露 3000 端口时必须留空，不能设为 true 或信任全部网段。
TRUST_PROXY=
MAX_DOCUMENT_UPLOAD_MB=20
MAX_VIDEO_UPLOAD_MB=100

MINERU_API_KEY=
MINERU_API_URL=https://mineru.net
MAX_MINERU_ZIP_MB=200
MAX_MINERU_EXTRACTED_MB=300
DOCUMENT_WORKER_CONCURRENCY=2
DOCUMENT_JOB_MAX_ATTEMPTS=3
DOCUMENT_QUEUE_TIMEOUT_MS=5000

LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
EMBED_MODEL=Xenova/bge-small-zh-v1.5
HF_MIRROR=https://hf-mirror.com
MCP_USER_ID=1
